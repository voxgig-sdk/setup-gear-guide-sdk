          {
            "name": "productId",
            "in": "query",
            "required": false,
            "description": "Product id. Provide this OR slug (at least one is required).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "query",
            "required": false,
            "description": "Product slug. Provide this OR productId (at least one is required).",
            "schema": {
              "type": "string"
            }
