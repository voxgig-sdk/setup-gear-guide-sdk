          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "bad_json",
                  "missing_param",
                  "bad_vertical",
                  "cross_vertical",
                  "not_found",
                  "method_not_allowed",
                  "no_template",
                  "rate_limited",
                  "internal"
