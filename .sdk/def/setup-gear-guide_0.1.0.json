      },
      "CompatibilityVerdict": {
        "type": "string",
        "enum": [
          "pass",
          "pass_with_unknowns",
          "warn",
          "fail",
          "no_applicable_rules"
        ],
        "description": "no_applicable_rules means no rule covered this product set (not a green pass)."
